# Separate migration owner and application login. Never commit actual passwords.
MIGRATION_DATABASE_URL=postgresql://migration_owner:replace-me@127.0.0.1:5432/lu4_rb
DATABASE_URL=postgresql://rb_runtime:replace-me@127.0.0.1:5432/lu4_rb
HOST=127.0.0.1
PORT=3001
# mkdir -p .credentials before provisioning; files are created with mode 0600.
CREDENTIAL_OUTPUT=.credentials/clan.json
